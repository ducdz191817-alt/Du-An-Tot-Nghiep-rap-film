# ============================================================
#  NOVA CINEMATIC - Backend Environment Variables
#  Sao chép file này thành .env và điền các giá trị thực
#  KHÔNG commit file .env lên Git!
# ============================================================


# ── SERVER ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development


# ── DATABASE (MongoDB) ──────────────────────────────────────
# Dùng MongoDB Atlas (cloud) hoặc local
MONGO_URI=mongodb://localhost:27017/movie-ticket-booking
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/nova-cinematic


# ── JWT SECRET ──────────────────────────────────────────────
# Thay bằng chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=change-this-to-a-very-long-random-secret-string-32chars


# ── APP URL (Frontend) ──────────────────────────────────────
APP_URL=http://localhost:5173


# ── EMAIL / SMTP (Gửi email xác nhận đặt vé) ────────────────
# Hướng dẫn dùng Gmail:
#   1. Bật 2-Step Verification tại: https://myaccount.google.com/security
#   2. Tạo App Password tại:        https://myaccount.google.com/apppasswords
#   3. Điền email Gmail và App Password (16 ký tự) vào bên dưới
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Nova Cinematic <your-email@gmail.com>"


# ── TMDB API (Lấy thông tin phim) ───────────────────────────
# Đăng ký tại: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here


# ── VNPAY (Thanh toán VNPay Sandbox) ────────────────────────
