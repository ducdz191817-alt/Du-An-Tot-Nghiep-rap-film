# ============================================================
#  NOVA CINEMATIC - Backend Environment Variables
#  Copy file này thành .env và điền thông tin thật
#  KHÔNG commit file .env lên Git!
# ============================================================

# ── SERVER ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── DATABASE (MongoDB) ──────────────────────────────────────
# Local MongoDB (mặc định sau khi cài MongoDB Community)
MONGO_URI=mongodb://127.0.0.1:27017/movie-ticket-booking
# Hoặc dùng MongoDB Atlas (cloud) - uncomment dòng dưới và comment dòng trên:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/movie-ticket-booking

# ── JWT SECRET ──────────────────────────────────────────────
JWT_SECRET=nova-cinematic-super-secret-jwt-key-2024-change-in-production

# ── APP URL (Frontend) ──────────────────────────────────────
APP_URL=http://localhost:5173

# ── EMAIL / SMTP (Gửi email xác nhận vé & khôi phục mật khẩu) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Nova Cinema <your-email@gmail.com>"

# ── TMDB API (Lấy thông tin phim) ───────────────────────────
TMDB_API_KEY=your-tmdb-api-key

# ── VNPAY (Thanh toán VNPay Sandbox) ────────────────────────
VNP_TMN_CODE=2QXUI2C7
VNP_HASH_SECRET=TS858W9CLXN6HO482G6CGB21H0B00C4D
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/vnpay-return

# ── MOMO (Thanh toán MoMo Sandbox) ──────────────────────────
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7h7j
MOMO_SECRET_KEY=at67qH6mk8w5Y1nAyMoYKMWACiEi2bsa
MOMO_REDIRECT_URL=http://localhost:5173/momo-return
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/ipn
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ── PAYOS (Cổng thanh toán PayOS) ───────────────────────────
# Đăng ký tại https://payos.vn để lấy credentials
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payos-return
PAYOS_CANCEL_URL=http://localhost:5173/payos-return?cancelled=true

# ── VIETQR / SEPAY (Mã QR chuyển khoản ngân hàng) ──────────
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=your-bank-account-number
VIETQR_ACCOUNT_NAME=YOUR FULL NAME
